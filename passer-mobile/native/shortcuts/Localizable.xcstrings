    "Send Text to PC" : {
      "localizations" : { "fr" : { "stringUnit" : { "state" : "translated", "value" : "Envoyer du texte au PC" } } }
    },
    "Sends photos or files to your PC: one image to its clipboard, anything else to the Passboard folder." : {
      "localizations" : { "fr" : { "stringUnit" : { "state" : "translated", "value" : "Envoie des photos ou des fichiers au PC : une image dans son presse-papiers, le reste dans le dossier Passboard." } } }
    },
    "Sends what you copied on this iPhone to your PC's clipboard. iOS may ask you to allow pasting." : {
      "localizations" : { "fr" : { "stringUnit" : { "state" : "translated", "value" : "Envoie ce que vous avez copié sur cet iPhone dans le presse-papiers du PC. iOS peut vous demander d'autoriser le collage." } } }
    },
    "Sends your latest screenshot to your PC, by default to its clipboard, ready to paste." : {
      "localizations" : { "fr" : { "stringUnit" : { "state" : "translated", "value" : "Envoie votre dernière capture d'écran au PC, par défaut dans son presse-papiers, prête à coller." } } }
    },
    "Sends your latest screenshot to your PC, then deletes it from the photo library. iOS asks you to confirm the deletion." : {
      "localizations" : { "fr" : { "stringUnit" : { "state" : "translated", "value" : "Envoie votre dernière capture d'écran au PC, puis la supprime de la photothèque. iOS demande de confirmer la suppression." } } }
    },
    "Sends your most recent photos to your PC: one to its clipboard, several to the Passboard folder." : {
      "localizations" : { "fr" : { "stringUnit" : { "state" : "translated", "value" : "Envoie vos photos les plus récentes au PC : une dans son presse-papiers, plusieurs dans le dossier Passboard." } } }
    },
    "Text" : {
      "localizations" : { "fr" : { "stringUnit" : { "state" : "translated", "value" : "Texte" } } }
