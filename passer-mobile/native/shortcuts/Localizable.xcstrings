    "Check PC" : {
      "localizations" : { "fr" : { "stringUnit" : { "state" : "translated", "value" : "Vérifier le PC" } } }
    },
    "Checks that your paired PC answers on this network, for example to run an automation only at home." : {
      "localizations" : { "fr" : { "stringUnit" : { "state" : "translated", "value" : "Vérifie que votre PC associé répond sur ce réseau, par exemple pour ne lancer une automatisation qu'à la maison." } } }
    },
    "Copies your PC's clipboard to this iPhone, ready to paste." : {
