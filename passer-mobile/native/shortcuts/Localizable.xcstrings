    },
    "PC Clipboard" : {
      "localizations" : { "fr" : { "stringUnit" : { "state" : "translated", "value" : "Presse-papiers du PC" } } }
    },
    "Puts text on your PC's clipboard, ready to paste." : {
      "localizations" : { "fr" : { "stringUnit" : { "state" : "translated", "value" : "Met du texte dans le presse-papiers du PC, prêt à coller." } } }
    },
    "Reads the image or the files copied on your PC, for the next action." : {
      "localizations" : { "fr" : { "stringUnit" : { "state" : "translated", "value" : "Récupère l'image ou les fichiers copiés sur le PC, pour l'action suivante." } } }
    },
    "Reads the text on your PC's clipboard, for the next action." : {
      "localizations" : { "fr" : { "stringUnit" : { "state" : "translated", "value" : "Lit le texte du presse-papiers du PC, pour l'action suivante." } } }
    },
