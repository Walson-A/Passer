      "localizations" : { "fr" : { "stringUnit" : { "state" : "translated", "value" : "Ouvre Passer sur vos fichiers, pour en envoyer au PC." } } }
    },
    "Opens Passer on your photos, to send some to your PC." : {
      "localizations" : { "fr" : { "stringUnit" : { "state" : "translated", "value" : "Ouvre Passer sur vos photos, pour en envoyer au PC." } } }
    },
    "Opens Passer, sends your latest screenshot to your PC, then deletes it." : {
