    },
    "Opens Passer and copies your PC's clipboard to this iPhone." : {
      "localizations" : { "fr" : { "stringUnit" : { "state" : "translated", "value" : "Ouvre Passer et copie le presse-papiers du PC sur cet iPhone." } } }
    },
    "Opens Passer and sends what you copied to your PC's clipboard." : {
      "localizations" : { "fr" : { "stringUnit" : { "state" : "translated", "value" : "Ouvre Passer et envoie ce que vous avez copié dans le presse-papiers du PC." } } }
    },
    "Opens Passer and sends your latest screenshot to your PC's clipboard." : {
      "localizations" : { "fr" : { "stringUnit" : { "state" : "translated", "value" : "Ouvre Passer et envoie votre dernière capture dans le presse-papiers du PC." } } }
    },
    "Opens Passer on the action you choose: your clipboard, your latest screenshot, a photo or a file." : {
      "localizations" : { "fr" : { "stringUnit" : { "state" : "translated", "value" : "Ouvre Passer sur l'action de votre choix : presse-papiers, dernière capture, photo ou fichier." } } }
    },
